{
  "name": "details-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:site": "pnpm --filter @details/site dev",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "test:browser": "pnpm -r --workspace-concurrency=1 --filter \"./packages/*\" test:browser",
    "ci": "pnpm -r --workspace-concurrency=1 --filter \"./packages/*\" run ci && pnpm --filter @details/site run typecheck && pnpm --filter @details/site run build",
    "changeset": "changeset",
    "version": "changeset version",
    "release:initial": "pnpm run ci && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "uqr": "^0.1.3"
  }
}
